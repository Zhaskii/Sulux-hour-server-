# Remote Postgres (Coolify / production). Use the same DATABASE_URL in Coolify server env.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
PAYLOAD_SECRET=use-a-long-random-string-at-least-32-chars

# Payload admin + REST API (Next.js on port 8000 in dev)
PAYLOAD_SERVER_URL=http://localhost:8000
# Customer storefront (Next.js client on port 3000) — used in auth emails
STOREFRONT_URL=http://localhost:3000
# Legacy alias for Payload serverURL; keep in sync with PAYLOAD_SERVER_URL
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
# Comma-separated — include admin + storefront origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

MINIO_ENDPOINT=
MINIO_REGION=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET=

